# 仓库内统一用 LF 存储，检出时按平台/配置转换
* text=auto

# cmd.exe 按字节偏移在批处理文件里定位，LF-only 会让它错行执行。
# 必须强制 CRLF，不受用户 core.autocrlf 设置影响。
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本必须保持 LF，CRLF 会让 shebang 失效（bad interpreter）
*.sh text eol=lf

# 待清理副本以原始字节核验，不能在跨平台检出时转换换行。
logic_version/pending_cleanup/** -text whitespace=cr-at-eol

# 已归档清单引用的原字节文档快照，保留换行及历史空白，由 SHA256 核验。
logic_version/backups/skill-document-clarity-20261012/*.md.txt -text -whitespace
logic_version/backups/six-improvements-20261012/*.md.txt -text -whitespace
logic_version/backups/reliable-context-20261013/*.md.txt -text -whitespace
